{
  "name": "saas-lead",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate:test": "pnpm --filter @saas-lead/database db:migrate:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "eslint": "10.0.3",
    "turbo": "2.11.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "5.0.3"
  }
}
