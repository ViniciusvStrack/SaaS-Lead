generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id          String               @id @default(uuid()) @db.Uuid
  email       String               @unique
  name        String
  status      UserStatus           @default(ACTIVE)
  memberships OrganizationMember[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Organization {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  slug             String               @unique
  status           OrganizationStatus   @default(ACTIVE)
  timezone         String               @default("America/Sao_Paulo")
  locale           String               @default("pt-BR")
  memberships      OrganizationMember[]
  businessSettings BusinessSettings?
  auditLogs         AuditLog[]
  whatsappAccounts WhatsAppAccount[]
  whatsappNumbers  WhatsAppNumber[]
  webhookEvents    WebhookEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model WhatsAppAccount {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  externalAccountId   String           @unique
  credentialReference String
  status              String           @default("ACTIVE")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numbers             WhatsAppNumber[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, status])
}

model WhatsAppNumber {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  accountId       String          @db.Uuid
  externalNumberId String         @unique
  displayNumber   String?
  status          String          @default("ACTIVE")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  webhookEvents   WebhookEvent[]
  createdAt       DateTime        @default(now())

  @@index([organizationId, status])
}

model WebhookEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  numberId       String         @db.Uuid
  externalId     String         @unique
  payload        Json
  status         String         @default("PENDING")
  attempts       Int            @default(0)
  receivedAt     DateTime       @default(now())
  processedAt    DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model BusinessSettings {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @db.Uuid
  industry           String?
  description        String?
  tone               String?
  businessHours      Json?
  allowedClaims      Json?
  discountPolicy     Json?
  commercialPolicies Json?
  goals              Json?
  version            Int          @default(1)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorType       String
  actorId         String?
  action          String
  resourceType    String
  resourceId      String?
  metadata        Json?
  occurredAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
}
