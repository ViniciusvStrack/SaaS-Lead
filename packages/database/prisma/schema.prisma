generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id          String               @id @default(uuid()) @db.Uuid
  email       String               @unique
  name        String
  status      UserStatus           @default(ACTIVE)
  memberships OrganizationMember[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Organization {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  slug             String               @unique
  status           OrganizationStatus   @default(ACTIVE)
  timezone         String               @default("America/Sao_Paulo")
  locale           String               @default("pt-BR")
  memberships      OrganizationMember[]
  businessSettings BusinessSettings?
  auditLogs         AuditLog[]
  whatsappAccounts WhatsAppAccount[]
  whatsappNumbers  WhatsAppNumber[]
  webhookEvents    WebhookEvent[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  aiAnalyses       AIAnalysis[]
  usageRecords     UsageRecord[]
  opportunities    Opportunity[]
  opportunityEvents OpportunityEvent[]
  consentRecords    ConsentRecord[]
  messageTemplates  MessageTemplate[]
  aiSuggestions     AISuggestion[]
  policyDecisions   PolicyDecision[]
  outboundMessages  OutboundMessage[]
  outboundEvents    OutboundMessageEvent[]
  subscriptions     Subscription[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model WhatsAppAccount {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  externalAccountId   String           @unique
  credentialReference String
  status              String           @default("ACTIVE")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numbers             WhatsAppNumber[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, status])
}

model WhatsAppNumber {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  accountId       String          @db.Uuid
  externalNumberId String         @unique
  displayNumber   String?
  status          String          @default("ACTIVE")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  webhookEvents   WebhookEvent[]
  conversations   Conversation[]
  createdAt       DateTime        @default(now())

  @@index([organizationId, status])
}

model WebhookEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  numberId       String         @db.Uuid
  externalId     String         @unique
  payload        Json
  status         String         @default("PENDING")
  attempts       Int            @default(0)
  receivedAt     DateTime       @default(now())
  processedAt    DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  message        Message?

  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}

model Contact {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  externalContactId String
  displayName       String?
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  consentRecords    ConsentRecord[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([organizationId, externalContactId])
  @@index([organizationId, displayName])
}

model Conversation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  contactId       String         @db.Uuid
  numberId        String         @db.Uuid
  status          String         @default("OPEN")
  lastMessageBody String?
  lastMessageAt   DateTime?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  number          WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  messages        Message[]
  aiAnalyses      AIAnalysis[]
  opportunities   Opportunity[]
  outboundMessages OutboundMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, numberId, contactId])
  @@index([organizationId, lastMessageAt])
}

model AIAnalysis {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  conversationId String       @db.Uuid
  inputHash      String
  promptVersion  String
  model          String
  analysis       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inputHash])
  @@index([organizationId, conversationId, createdAt])
}

model UsageRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  inputHash      String?
  provider       String?
  model          String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  estimatedCost  Decimal?     @db.Decimal(12, 6)
  metric         String       @default("ai.tokens")
  quantity       Int          @default(1)
  unitCost       Decimal?     @db.Decimal(12, 6)
  sourceType     String       @default("AIAnalysis")
  sourceId       String
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inputHash, provider])
  @@unique([organizationId, metric, sourceType, sourceId])
  @@index([organizationId, createdAt])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  status        String         @default("ACTIVE")
  entitlements  Json
  pricingConfig Json
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @db.Uuid
  planId                  String       @db.Uuid
  provider                String
  externalCustomerId      String
  externalSubscriptionId  String
  creationIdempotencyKey  String
  status                  String
  trialEndsAt             DateTime?
  currentPeriodEndsAt     DateTime?
  lastEventAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                    Plan         @relation(fields: [planId], references: [id])

  @@unique([organizationId, provider])
  @@unique([provider, externalSubscriptionId])
  @@unique([organizationId, creationIdempotencyKey])
  @@index([organizationId, status])
}

model BillingEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  externalEventId String
  payloadRef      String?
  status          String    @default("RECEIVED")
  eventCreatedAt  DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
}

model Opportunity {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  conversationId   String             @db.Uuid
  deduplicationKey String
  type             String
  priority         String
  status           String             @default("OPEN")
  knownValue       Decimal?           @db.Decimal(14, 2)
  ruleVersion      String
  evidence         Json
  detectedAt       DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation     Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events           OpportunityEvent[]
  suggestions      AISuggestion[]
  outboundMessages OutboundMessage[]

  @@unique([organizationId, deduplicationKey])
  @@index([organizationId, status, priority, detectedAt])
  @@index([organizationId, conversationId])
}

model OpportunityEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  opportunityId  String       @db.Uuid
  type           String
  metadata       Json?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, opportunityId, occurredAt])
}

model ConsentRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contactId      String       @db.Uuid
  channel        String       @default("WHATSAPP")
  status         String
  source         String
  capturedAt     DateTime
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId, channel, capturedAt])
}

model MessageTemplate {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  externalTemplateId String
  name               String
  category           String
  language           String
  status             String
  components         Json
  syncedAt           DateTime
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalTemplateId])
  @@index([organizationId, status])
}

model AISuggestion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  opportunityId  String       @db.Uuid
  analysisId     String?      @db.Uuid
  content        String
  editedContent  String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, opportunityId, createdAt])
}

model OutboundMessage {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @db.Uuid
  conversationId          String                 @db.Uuid
  opportunityId           String?                @db.Uuid
  suggestionId            String?                @db.Uuid
  idempotencyKey          String
  currentPolicyDecisionId String?                @db.Uuid
  status                  String                 @default("PENDING_APPROVAL")
  content                 String
  contentHash             String
  templateId              String?                @db.Uuid
  externalMessageId       String?
  scheduledAt             DateTime?
  sentAt                  DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation            Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  opportunity             Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  policyDecisions         PolicyDecision[]
  events                  OutboundMessageEvent[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, externalMessageId])
  @@index([organizationId, status, createdAt])
}

model PolicyDecision {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  outboundMessageId String?          @db.Uuid
  decision          String
  reasons           Json
  policyVersion     String
  contextSnapshot   Json
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboundMessage   OutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  @@index([organizationId, outboundMessageId, createdAt])
}

model OutboundMessageEvent {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  outboundMessageId String          @db.Uuid
  externalEventId   String
  status            String
  payload            Json?
  occurredAt         DateTime        @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboundMessage   OutboundMessage @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalEventId])
  @@index([organizationId, outboundMessageId, occurredAt])
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  conversationId    String       @db.Uuid
  webhookEventId    String?      @unique @db.Uuid
  externalMessageId String
  direction         String
  body              String?
  payload           Json?
  occurredAt        DateTime
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  webhookEvent      WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())

  @@unique([organizationId, externalMessageId])
  @@index([organizationId, conversationId, occurredAt])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model BusinessSettings {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @db.Uuid
  industry           String?
  description        String?
  tone               String?
  businessHours      Json?
  allowedClaims      Json?
  discountPolicy     Json?
  commercialPolicies Json?
  goals              Json?
  version            Int          @default(1)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorType       String
  actorId         String?
  action          String
  resourceType    String
  resourceId      String?
  metadata        Json?
  occurredAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
}
