generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id          String               @id @default(uuid()) @db.Uuid
  email       String               @unique
  name        String
  status      UserStatus           @default(ACTIVE)
  memberships OrganizationMember[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Organization {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  slug             String               @unique
  status           OrganizationStatus   @default(ACTIVE)
  timezone         String               @default("America/Sao_Paulo")
  locale           String               @default("pt-BR")
  memberships      OrganizationMember[]
  businessSettings BusinessSettings?
  auditLogs         AuditLog[]
  whatsappAccounts WhatsAppAccount[]
  whatsappNumbers  WhatsAppNumber[]
  webhookEvents    WebhookEvent[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  aiAnalyses       AIAnalysis[]
  usageRecords     UsageRecord[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model WhatsAppAccount {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  externalAccountId   String           @unique
  credentialReference String
  status              String           @default("ACTIVE")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numbers             WhatsAppNumber[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, status])
}

model WhatsAppNumber {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  accountId       String          @db.Uuid
  externalNumberId String         @unique
  displayNumber   String?
  status          String          @default("ACTIVE")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  webhookEvents   WebhookEvent[]
  conversations   Conversation[]
  createdAt       DateTime        @default(now())

  @@index([organizationId, status])
}

model WebhookEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  numberId       String         @db.Uuid
  externalId     String         @unique
  payload        Json
  status         String         @default("PENDING")
  attempts       Int            @default(0)
  receivedAt     DateTime       @default(now())
  processedAt    DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  message        Message?

  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}

model Contact {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  externalContactId String
  displayName       String?
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([organizationId, externalContactId])
  @@index([organizationId, displayName])
}

model Conversation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  contactId       String         @db.Uuid
  numberId        String         @db.Uuid
  status          String         @default("OPEN")
  lastMessageBody String?
  lastMessageAt   DateTime?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  number          WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  messages        Message[]
  aiAnalyses      AIAnalysis[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, numberId, contactId])
  @@index([organizationId, lastMessageAt])
}

model AIAnalysis {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  conversationId String       @db.Uuid
  inputHash      String
  promptVersion  String
  model          String
  analysis       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inputHash])
  @@index([organizationId, conversationId, createdAt])
}

model UsageRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  inputHash      String
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  estimatedCost  Decimal?     @db.Decimal(12, 6)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inputHash, provider])
  @@index([organizationId, createdAt])
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  conversationId    String       @db.Uuid
  webhookEventId    String?      @unique @db.Uuid
  externalMessageId String
  direction         String
  body              String?
  payload           Json?
  occurredAt        DateTime
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  webhookEvent      WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())

  @@unique([organizationId, externalMessageId])
  @@index([organizationId, conversationId, occurredAt])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model BusinessSettings {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @db.Uuid
  industry           String?
  description        String?
  tone               String?
  businessHours      Json?
  allowedClaims      Json?
  discountPolicy     Json?
  commercialPolicies Json?
  goals              Json?
  version            Int          @default(1)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorType       String
  actorId         String?
  action          String
  resourceType    String
  resourceId      String?
  metadata        Json?
  occurredAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
}
